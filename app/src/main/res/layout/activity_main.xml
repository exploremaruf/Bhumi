<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bhumi"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#D647BD"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50dp"
        android:fontFamily="@font/playwriteidvariablefontwght"/>
    <TextView
        android:id="@+id/apptagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="fast . accurate . simple"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#D647BD"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp"
        android:fontFamily="@font/playwriteidvariablefontwght"/>


    <RelativeLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/rectangle_curved"
        android:backgroundTint="#0A000000"
        android:padding="20dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animationView"
                android:layout_width="180dp"
                android:layout_height="120dp"
                app:lottie_rawRes="@raw/hello_anim"
                app:lottie_autoPlay="true"
                app:lottie_loop="false"
                android:scaleType="centerCrop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/getstartedbtn"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_gradient"
                android:text="পরিমাপ শুরু করুন"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textAllCaps="false"
                app:backgroundTint="@null"
                app:elevation="8dp"/>

        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>